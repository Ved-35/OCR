{
  "name": "backend",
  "version": "1.0.0",
  "description": "Node.js Express TypeScript Backend Server with OCR Microservice",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "tsx --watch src/index.ts",
    "build": "yarn install --production=false && tsc",
    "start": "node --experimental-specifier-resolution=node dist/index.js",
    "lint": "tsc --noEmit",
    "postinstall": "node scripts/fix-deps.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@google/generative-ai": "^0.24.1",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.1.29",
    "@nestjs/core": "^11.1.29",
    "@nestjs/platform-express": "^11.1.29",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.24",
    "axios": "^1.19.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "file-type": "^19.6.0",
    "mupdf": "^1.28.0",
    "onnxruntime-node": "1.20.1",
    "pdf-lib": "^1.17.1",
    "ppu-paddle-ocr": "^1.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.33.5",
    "typescript": "^5.3.3"
  },
  "devDependencies": {
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12"
  },
  "overrides": {
    "onnxruntime-node": "1.20.1",
    "ppu-paddle-ocr": {
      "onnxruntime-node": "1.20.1"
    }
  },
  "resolutions": {
    "onnxruntime-node": "1.20.1"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
